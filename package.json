{
  "name": "rapid-reload",
  "version": "0.1.0",
  "description": "Keep a local Docker Compose stack on the latest commit of a Git branch: each push rebuilds only what changed, and data is wiped only when you say so. Status page, test-data hooks, no runtime dependencies.",
  "type": "module",
  "bin": {
    "rapid-reload": "bin/rapid-reload.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "container/",
    "AGENTS.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/unit/",
    "test:e2e": "RAPID_RELOAD_E2E=1 node --test --test-timeout=1800000 test/e2e/",
    "check:clean": "node scripts/check-clean.mjs"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "preview",
    "staging",
    "pre-merge",
    "git",
    "poller",
    "local",
    "reload",
    "compose"
  ],
  "license": "MIT"
}
